{
  "file": "%APPDATA%/com.claude-usage-tracker.app/settings.json",
  "writer": "app",
  "scopes": {
    "ui": "читает только приложение (UI или Rust); CLI ключ не знает",
    "shared": "читают приложение и CLI; ключ обязан быть известен обеим сторонам",
    "hook": "читает только CLI; приложение ключ не читает и не пишет"
  },
  "writers": {
    "app": "пишет приложение (главное окно или панель настроек) по ключу через plugin-store",
    "manual": "правится руками в settings.json; приложение ключ не трогает, plugin-store пишет по ключу и чужие ключи не затирает"
  },
  "keys": [
    { "key": "sessionKey", "scope": "ui", "writer": "app", "readers": ["ui"], "default": "" },
    { "key": "orgId", "scope": "ui", "writer": "app", "readers": ["ui"], "default": "" },
    { "key": "refreshInterval", "scope": "ui", "writer": "app", "readers": ["ui"], "default": 60 },
    { "key": "autoStartSession", "scope": "ui", "writer": "app", "readers": ["ui"], "default": false },
    { "key": "projectId", "scope": "ui", "writer": "app", "readers": ["ui"], "default": "" },
    { "key": "thresholdsSession", "scope": "ui", "writer": "app", "readers": ["ui"], "defaultFrom": "src/thresholds.ts normalize()" },
    { "key": "thresholdsWeekly", "scope": "ui", "writer": "app", "readers": ["ui"], "defaultFrom": "src/thresholds.ts normalize()" },
    { "key": "notificationsEnabled", "scope": "ui", "writer": "app", "readers": ["ui"], "default": false },
    { "key": "notifyForecastMinutes", "scope": "ui", "writer": "app", "readers": ["ui"], "default": 30 },
    { "key": "forecastWindowMinutes", "scope": "ui", "writer": "app", "readers": ["ui"], "default": 60 },
    { "key": "alertTiers", "scope": "ui", "writer": "app", "readers": ["ui"], "defaultFrom": "src/thresholds.ts normalizeAlertTiers()" },
    { "key": "alertTypes", "scope": "ui", "writer": "app", "readers": ["ui"], "defaultFrom": "src/thresholds.ts normalizeAlertTypes()" },
    { "key": "quietHoursEnabled", "scope": "ui", "writer": "app", "readers": ["ui"], "default": false },
    { "key": "quietHoursStart", "scope": "ui", "writer": "app", "readers": ["ui"], "default": "23:00" },
    { "key": "quietHoursEnd", "scope": "ui", "writer": "app", "readers": ["ui"], "default": "08:00" },
    { "key": "ccAnalyticsEnabled", "scope": "ui", "writer": "app", "readers": ["ui"], "default": false },
    { "key": "dailyBudgetEnabled", "scope": "ui", "writer": "app", "readers": ["ui"], "default": false },
    { "key": "dailyBudget", "scope": "ui", "writer": "app", "readers": ["ui"], "default": 0 },
    { "key": "goalCostPerHourMax", "scope": "ui", "writer": "app", "readers": ["ui"], "default": null },
    { "key": "goalErrorRateMax", "scope": "ui", "writer": "app", "readers": ["ui"], "default": null },
    { "key": "notificationsMutedUntil", "scope": "ui", "writer": "app", "readers": ["ui"], "default": null },
    { "key": "serviceStatusEnabled", "scope": "ui", "writer": "app", "readers": ["ui"], "default": true },
    { "key": "serviceStatusInterval", "scope": "ui", "writer": "app", "readers": ["ui"], "default": 90 },
    { "key": "serviceStatusNotify", "scope": "ui", "writer": "app", "readers": ["ui"], "default": true },
    { "key": "memoryBloatEnabled", "scope": "ui", "writer": "app", "readers": ["ui"], "default": true },
    { "key": "todoNotificationsEnabled", "scope": "ui", "writer": "app", "readers": ["ui"], "default": true },
    { "key": "runtimeInsightsEnabled", "scope": "ui", "writer": "app", "readers": ["ui"], "default": false },
    { "key": "runtimeInsightKinds", "scope": "ui", "writer": "app", "readers": ["ui"], "default": ["long_session", "cold_rewrites"] },
    { "key": "systemInfoEnabled", "scope": "ui", "writer": "app", "readers": ["ui"], "default": true },
    { "key": "correctionsEnabled", "scope": "ui", "writer": "app", "readers": ["ui"], "default": false },
    { "key": "locale", "scope": "ui", "writer": "app", "readers": ["ui"], "default": null },
    { "key": "uiFont", "scope": "ui", "writer": "app", "readers": ["ui"], "defaultFrom": "src/fontSwitch.ts DEFAULT_FONT_ID" },
    { "key": "ignoredInsights", "scope": "ui", "writer": "app", "readers": ["ui"], "default": [], "direct": true },
    { "key": "resolverUrl", "scope": "ui", "writer": "app", "readers": ["ui"], "default": "", "direct": true },
    { "key": "updateCheckHours", "scope": "ui", "writer": "app", "readers": ["ui"], "default": 6, "direct": true },
    { "key": "releasesCache", "scope": "ui", "writer": "app", "readers": ["ui"], "default": null, "direct": true },
    { "key": "externalStatusMap", "scope": "ui", "writer": "app", "readers": ["ui"], "default": {}, "direct": true },
    { "key": "specsEnabled", "scope": "shared", "writer": "app", "readers": ["ui", "cli"], "default": false },
    { "key": "taskContextPriority", "scope": "shared", "writer": "app", "readers": ["ui", "cli"], "default": "medium", "direct": true },
    { "key": "hookContextEnabled", "scope": "shared", "writer": "app", "readers": ["ui", "cli"], "default": true, "direct": true },
    { "key": "workflowContextEnabled", "scope": "shared", "writer": "app", "readers": ["ui", "cli"], "default": false, "direct": true },
    { "key": "taskHandoffGuard", "scope": "shared", "writer": "app", "readers": ["ui", "cli"], "default": "both", "direct": true },
    { "key": "specRoot", "scope": "shared", "writer": "manual", "readers": ["rust", "cli"], "default": "docs/specs" },
    { "key": "specDeltaGuard", "scope": "hook", "writer": "manual", "readers": ["cli"], "default": "on" },
    { "key": "matchPlanCli", "scope": "hook", "writer": "manual", "readers": ["cli"], "default": "" },
    { "key": "specRepos", "scope": "hook", "writer": "manual", "readers": ["cli"], "default": {} }
  ],
  "legacy": [
    { "key": "thresholds", "note": "до разделения на thresholdsSession/thresholdsWeekly; читается только как fallback миграции в settingsStore.ts" },
    { "key": "openAiAdminEnabled", "note": "удаляется при чтении снапшота" },
    { "key": "openAiAdminKey", "note": "удаляется при чтении снапшота" },
    { "key": "openAiUsageDays", "note": "удаляется при чтении снапшота" }
  ]
}
